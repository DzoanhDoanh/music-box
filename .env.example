# Enable with ENABLE_LUDO after applying the game migration; rebuild after changing.
VITE_ENABLE_LUDO=true
# Opt in only after the wheel migration and ENABLE_WHEEL=true; build:game enables the local trial.
VITE_ENABLE_WHEEL=false
# Enable only after Bầu Cua migrations and ENABLE_BAU_CUA=true; rebuild required.
VITE_ENABLE_BAU_CUA=false
# Duck Race remains opt-in; apply its migration and enable the Worker flag on staging first.
VITE_ENABLE_DUCK_RACE=false

# Enable only after the Tỷ Phú migration and ENABLE_TY_PHU=true; rebuild required.
VITE_ENABLE_TY_PHU=false
# Enable only after the Tarot migration and ENABLE_TAROT=true; rebuild required.
VITE_ENABLE_TAROT=false
