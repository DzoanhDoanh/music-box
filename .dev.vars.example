SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
YOUTUBE_API_KEY=
APP_BASE_URL=http://localhost:5173
# Requires migration 202611140004_ludo.sql and VITE_ENABLE_LUDO=true at build time.
ENABLE_LUDO=true
# Requires migration 202611160001_lucky_wheel.sql and VITE_ENABLE_WHEEL=true at build time.
ENABLE_WHEEL=false
# Apply all 202611170007–009 Bầu Cua migrations before enabling the API.
ENABLE_BAU_CUA=false
# Requires 202611180002_duck_race.sql and VITE_ENABLE_DUCK_RACE=true at build time.
ENABLE_DUCK_RACE=false

# Requires 202611250001_ty_phu.sql and VITE_ENABLE_TY_PHU=true at build time.
ENABLE_TY_PHU=false
# Requires 202611270002_co_tuong.sql and VITE_ENABLE_CO_TUONG=true at build time.
ENABLE_CO_TUONG=false
# Requires 202611270003_billiards.sql and VITE_ENABLE_BILLIARDS=true at build time.
ENABLE_BILLIARDS=false
# Requires 202611260002_tarot.sql and VITE_ENABLE_TAROT=true at build time.
ENABLE_TAROT=false
# Optional: Google AI Studio key (https://aistudio.google.com/apikey). When set, every Tarot
# reading also gets a long AI-written interpretation. Requires 202611260004_tarot_ai.sql.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-flash-latest, falling back to gemini-flash-lite-latest when busy.
GEMINI_MODEL=
