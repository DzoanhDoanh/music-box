{
  "name": "roomtune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:game": "node scripts/build-game.mjs",
    "build:bau": "node scripts/build-bau-cua.mjs",
    "build:duck": "node scripts/build-duck-race.mjs",
    "duck:preview": "node scripts/preview-duck-race.mjs",
    "game:start": "powershell.exe -NoProfile -File scripts/game-trial.ps1 Start",
    "game:stop": "powershell.exe -NoProfile -File scripts/game-trial.ps1 Stop",
    "game:status": "powershell.exe -NoProfile -File scripts/game-trial.ps1 Status",
    "preview": "vite preview",
    "public:start": "powershell.exe -NoProfile -File scripts/public.ps1 Start",
    "public:stop": "powershell.exe -NoProfile -File scripts/public.ps1 Stop",
    "public:status": "powershell.exe -NoProfile -File scripts/public.ps1 Status",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "test:db:bau": "node scripts/test-bau-cua.mjs",
    "test:db:duck": "node scripts/test-duck-race.mjs",
    "test:db:ty-phu": "node scripts/test-ty-phu.mjs",
    "test:db:co-tuong": "node scripts/test-co-tuong.mjs",
    "test:db:billiards": "node scripts/test-billiards.mjs",
    "test:db:tarot": "node scripts/test-tarot.mjs",
    "test:e2e:duck": "node scripts/test-duck-browser.mjs",
    "test:e2e:bau": "playwright test --config playwright.bau.config.ts",
    "test:e2e:ty-phu": "playwright test --config playwright.typhu.config.ts",
    "test:e2e:co-tuong": "playwright test --config playwright.cotuong.config.ts",
    "test:e2e:billiards": "playwright test --config playwright.billiards.config.ts",
    "test:e2e:tarot": "playwright test --config playwright.tarot.config.ts",
    "deploy": "pnpm build && wrangler deploy",
    "db:start": "supabase start",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/shared/database.types.ts",
    "test:e2e:room": "playwright test --config playwright.room.config.ts",
    "test:e2e:game": "playwright test --config playwright.game.config.ts",
    "test:e2e:activities": "playwright test --config playwright.activities.config.ts",
    "check:services": "node scripts/check-services.mjs",
    "test:hosted": "node scripts/test-hosted.mjs",
    "test:hosted:bau": "node scripts/test-bau-hosted.mjs",
    "test:hosted:duck": "node scripts/test-duck-hosted.mjs",
    "test:hosted:game": "node scripts/test-game-hosted.mjs",
    "test:hosted:recommendations": "node scripts/test-recommendations-hosted.mjs",
    "test:hosted:members": "node scripts/test-members-hosted.mjs",
    "test:hosted:wheel": "node scripts/test-wheel-hosted.mjs",
    "admin:grant": "node scripts/provision-admin.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.11.1",
    "lucide-react": "^0.562.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.71.0",
    "react-router-dom": "^7.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "three": "~0.181.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@cloudflare/vite-plugin": "^1.52.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "~0.181.0",
    "@types/youtube": "^0.1.2",
    "@vitejs/plugin-react": "^5.1.1",
    "embedded-postgres": "17.6.0-beta.15",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "lighthouse": "13.6.0",
    "postgres": "^3.4.8",
    "prettier": "3.6.2",
    "supabase": "^2.72.7",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.17",
    "wrangler": "^4.136.1"
  }
}
